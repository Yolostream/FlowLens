{
  "name": "SampleFlow",
  "displayName": "Synthetic SharePoint notification",
  "definition": {
    "triggers": {
      "Recurrence": {
        "type": "Recurrence",
        "recurrence": {"frequency": "Day", "interval": 1}
      }
    },
    "actions": {
      "Get_items": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
            "connectionName": "shared_sharepointonline"
          },
          "parameters": {
            "dataset": "https://contoso.sharepoint.com/sites/example",
            "table": "11111111-1111-4111-8111-111111111111"
          }
        }
      },
      "Notify_owner": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
            "connectionName": "shared_office365"
          },
          "parameters": {"emailMessage/To": "maker@example.invalid"}
        }
      },
      "Call_example_API": {
        "type": "Http",
        "inputs": {"method": "GET", "uri": "https://api.example.invalid/status"}
      }
    }
  }
}
